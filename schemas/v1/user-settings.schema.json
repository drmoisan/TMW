{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["userId", "notificationsEnabled", "triageEnabled", "lastModifiedAt"],
  "properties": {
    "userId": {
      "type": "string"
    },
    "notificationsEnabled": {
      "type": "boolean"
    },
    "triageEnabled": {
      "type": "boolean"
    },
    "lastModifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "archiveRootDriveItemId": {
      "type": ["string", "null"],
      "description": "OneDrive drive-item id of the iFile Archive root chosen by the user (Issue #43, OD-6). Optional; null until first-use selection."
    }
  },
  "additionalProperties": false
}
